# Configuración de ChromaDB
CHROMA_DB_DIR=./data/chroma

# Base de datos estructurada (SQLite en desarrollo; Postgres en producción)
DATABASE_URL=sqlite:///./data/quark.db

# Modelo de embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Configuración de seguridad
# Obligatoria: la app falla al arrancar si no está seteada (no tiene default).
ADMIN_PASSWORD=your_admin_password_here
# Opcional: default `admin`. Username del admin que crea `python -m app.cli bootstrap`.
# ADMIN_USERNAME=admin
# Cadena aleatoria de al menos 32 caracteres.
AUTH_SECRET_KEY=your_secret_key_here
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
